{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist-agent",
    "rootDir": "src",
    "isolatedModules": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/agent/**/*.ts"],
  "exclude": ["src/agent/**/*.test.ts"]
}
